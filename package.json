{
  "name": "ai-visibility-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "cloudflare": {
    "bindings": {
      "DATAFORSEO_LOGIN": {
        "description": "Your DataForSEO API login."
      },
      "DATAFORSEO_PASSWORD": {
        "description": "Your DataForSEO API password."
      },
      "DATAFORSEO_WEBHOOK_TOKEN": {
        "description": "Generate a unique high-entropy value used to authenticate DataForSEO postbacks."
      },
      "APP_CRYPTO_KEY": {
        "description": "Generate an independent high-entropy value used to sign provider job tags."
      },
      "BOOTSTRAP_TOKEN": {
        "description": "Generate an independent high-entropy value. You will enter it once on the first-run setup screen."
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint --max-warnings 0 && pnpm test && pnpm build",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "r2:lifecycle": "wrangler r2 bucket lifecycle set ai-tracker-evidence --file infrastructure/r2-lifecycle.json --force",
    "deploy": "wrangler deploy && pnpm db:migrate:remote",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "latest",
    "@js-temporal/polyfill": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-table": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "flag-icons": "latest",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "remark-gfm": "latest",
    "tailwind-merge": "latest",
    "tldts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "~6.0.2",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
